APP_NAME=Patient Journey Orchestrator API
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg2://postgres:vansh@localhost:5432/patient_journey_orchestrator

# Authentication: set AUTH_REQUIRED=true to enforce JWT auth (Entra ID in production).
AUTH_REQUIRED=false
AUTH_JWT_SECRET=CHANGE_ME_IN_PRODUCTION
AUTH_JWT_EXPIRES_MINUTES=480

AZURE_TENANT_ID=YOUR_TENANT_ID
AZURE_CLIENT_ID=YOUR_BACKEND_API_CLIENT_ID
AZURE_AUDIENCE=api://YOUR_BACKEND_API_CLIENT_ID
AZURE_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
DEV_USER_ENTRA_OBJECT_ID=local-development-user
DEV_USER_EMAIL=developer@carepath-health.example
DEV_USER_NAME=Local Development User
DEV_USER_ROLE=CARE_COORDINATOR

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# MAQ AI
MAQ_AI_BASE_URL=https://llm.maqsoftware.net/v1
MAQ_AI_API_KEY=sk-Du8ZT2cfDL2nvf8aHL7gFg
MAQ_AI_MODEL=qwen-3.8-27b
MAQ_AI_TIMEOUT_SECONDS=90
MAQ_AI_TEMPERATURE=0
MAQ_AI_ENABLED=true

# Supervisor limits
SUPERVISOR_MAX_ITERATIONS=6
AGENT_CONTEXT_EVENT_LIMIT=12
