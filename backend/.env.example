APP_NAME=Patient Journey Orchestrator API
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
# DATABASE_URL=postgresql+psycopg2://postgres:vansh@localhost:5432/patient_journey_orchestrator
# Neon: paste the full connection URL, retaining sslmode=require and other options.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require

# Email/password authentication and signed API session tokens.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_EXPIRES_MINUTES=480

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# MAQ AI
MAQ_AI_BASE_URL=https://llm.maqsoftware.net/v1
MAQ_AI_API_KEY=sk-Du8ZT2cfDL2nvf8aHL7gFg
MAQ_AI_MODEL=qwen-3.8-27b
MAQ_AI_TIMEOUT_SECONDS=600
MAQ_AI_TEMPERATURE=0
MAQ_AI_ENABLED=true

# Supervisor limits
SUPERVISOR_MAX_ITERATIONS=6
AGENT_CONTEXT_EVENT_LIMIT=12

# Outbound email for agent actions (reminders, document/appointment requests).
# Leave SMTP_HOST empty to keep using the simulated (mock) services.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# While testing, send every email to this address instead of real patients:
SMTP_REDIRECT_TO=
